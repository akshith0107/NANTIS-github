{
  "name": "nantis",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "fixtures"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "npm run dev:web",
    "dev:web": "tsx apps/web/src/server.ts",
    "scan": "tsx packages/core/src/cli/scan.ts",
    "compare": "tsx packages/core/src/cli/compare.ts",
    "scoreboard": "tsx packages/core/src/cli/scoreboard.ts",
    "mutation-harness": "tsx packages/core/src/cli/mutation-harness.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
