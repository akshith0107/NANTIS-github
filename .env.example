# NANTIS Web Application Environment Variables
# Copy to .env for local development

# GitHub OAuth App Credentials (User Login)
GITHUB_CLIENT_ID=ov_test_FAKE_CLIENT_ID_12345
GITHUB_CLIENT_SECRET=sec_test_FAKE_CLIENT_SECRET_abc1234567890

# GitHub App Credentials (Repository Access & Webhooks)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0FAKEKEYHEADER...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=whsec_test_FAKE_WEBHOOK_SECRET_987654321

# Web Application Security & Database
SESSION_SECRET=session_secret_32_chars_minimum_length_for_hmac_sha256
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nantis_db
NODE_ENV=development
