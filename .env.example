# NANTIS Web Application Environment Variables
# Copy this template to .env for local development

# ==============================================================================
# GitHub OAuth & App Credentials (Required)
# ==============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ==============================================================================
# Web Application Security & Session Configuration (Required)
# ==============================================================================
SESSION_SECRET=

# ==============================================================================
# Database & Runtime Configuration (Optional)
# ==============================================================================
# Database connection string (defaults to postgresql://localhost:5432/nantis_db if omitted)
DATABASE_URL=

# Environment mode: development | production | test (defaults to development)
NODE_ENV=development

# Cache TTL for user repository list in milliseconds (defaults to 3600000 / 1 hour)
USER_REPO_SNAPSHOT_TTL_MS=3600000

# Enable dev login bypass in local development (strictly forbidden in production mode)
# ALLOW_DEV_LOGIN=true
